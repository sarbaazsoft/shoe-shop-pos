# Database connection (PostgreSQL)
DATABASE_URL=

# Authentication secret
JWT_SECRET=

# Google Gemini AI API key (for footwear AI catalog vision & suggestions)
GEMINI_API_KEY=

# Note: The application URL (domain, protocol, port) is automatically detected
# dynamically from incoming HTTP request headers (Origin, Host, X-Forwarded-Host, X-Forwarded-Proto).
# No APP_URL environment variable is needed.

# Note: Email configuration (Resend API key, Gmail SMTP credentials, sender email)
# is strictly stored and managed in the PostgreSQL `app_setting` table via the SuperAdmin UI
# (SuperAdmin -> Settings -> Email Settings) and should NOT be placed in this .env file.